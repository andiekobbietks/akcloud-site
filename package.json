    "test:all": "npm test && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "netlify-cli": "^17.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
